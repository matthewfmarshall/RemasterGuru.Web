# Local API (see RemasterGuru.Api README). macOS often reserves port 5000 for AirPlay — API uses 5055.
NEXT_PUBLIC_API_URL=http://localhost:5055
NEXT_PUBLIC_DEV_USER_ID=84AD0816-39F0-480F-93F9-2D370D27CA7C

# --- Auth0 (optional; omit for X-User-Id dev mode) ---
# Full Dashboard walkthrough (new free tenant): RemasterGuru.Api/docs/auth0-setup.md
# AUTH0_SECRET=                    # openssl rand -hex 32
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=https://api.remasterguru.com
# AUTH0_BASE_URL=http://localhost:3000
# APP_BASE_URL=http://localhost:3000
# (next.config exposes AUTH0_BASE_URL to the browser as NEXT_PUBLIC_APP_BASE_URL for the /api/v1 BFF)
# API_INTERNAL_URL=http://localhost:5055
# HF staging example:
# AUTH0_BASE_URL=https://YOUR-ORG-YOUR-SPACE.hf.space

# Stripe: keys live on RemasterGuru.Api only (Stripe__SecretKey, Stripe__WebhookSecret).
# The Web app redirects to Stripe Checkout URLs returned by the API — no publishable key needed here.
